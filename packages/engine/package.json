{
  "name": "@ikijs/engine",
  "version": "0.3.0",
  "description": "WebGL2 runtime that plays .iki 2D puppet models in the browser — an open-source Live2D alternative for VTuber-style avatar animation",
  "keywords": [
    "iki",
    "live2d",
    "inochi2d",
    "vtuber",
    "2d-animation",
    "puppet",
    "rig",
    "avatar",
    "webgl",
    "webgl2",
    "animation",
    "typescript"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ikijs/format": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeikar/iki.git",
    "directory": "packages/engine"
  },
  "author": {
    "name": "Zeikar",
    "url": "https://github.com/zeikar"
  },
  "homepage": "https://github.com/zeikar/iki#readme",
  "bugs": {
    "url": "https://github.com/zeikar/iki/issues"
  }
}
