{
  "name": "@ikijs/mcp",
  "version": "0.3.0",
  "description": "MCP server that lets AI agents read, validate and auto-rig .iki 2D puppet models from role-named PNG layers",
  "keywords": [
    "iki",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "live2d",
    "vtuber",
    "2d-animation",
    "puppet",
    "auto-rig",
    "rigging"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "iki-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ikijs/editor": "workspace:^",
    "@ikijs/format": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "sharp": "^0.33.5",
    "zod": "^3.25"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeikar/iki.git",
    "directory": "packages/mcp"
  },
  "author": {
    "name": "Zeikar",
    "url": "https://github.com/zeikar"
  },
  "homepage": "https://github.com/zeikar/iki#readme",
  "bugs": {
    "url": "https://github.com/zeikar/iki/issues"
  }
}
