{
  "name": "@ikijs/editor",
  "version": "0.21.0",
  "description": "Headless editing core and auto-rigger for .iki 2D puppet models: measures role-named part layers from decoded pixels, AI-drawn or hand-made, and rigs them into a character. DOM-free edit commands, undo/redo, atlas math.",
  "keywords": [
    "iki",
    "live2d",
    "vtuber",
    "2d-animation",
    "puppet",
    "rig",
    "rigging",
    "auto-rig",
    "editor",
    "avatar",
    "animation",
    "typescript",
    "ai",
    "auto-rigging",
    "character-generation",
    "live2d-alternative"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ikijs/format": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeikar/iki.git",
    "directory": "packages/editor"
  },
  "author": {
    "name": "Zeikar",
    "url": "https://github.com/zeikar"
  },
  "homepage": "https://github.com/zeikar/iki#readme",
  "bugs": {
    "url": "https://github.com/zeikar/iki/issues"
  }
}
